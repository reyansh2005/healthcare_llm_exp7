# Cloud LLM configuration. Replace every <...> placeholder locally.
# Hugging Face Inference Providers:
# LLM_API_BASE=https://router.huggingface.co/v1
# LLM_MODEL_ID=<provider-supported-model-id>
# Groq:
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL_ID=<groq-supported-model-id>
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=<paste-your-provider-key-here>
LLM_MODEL_ID=<current-groq-model-id>
LLM_TEMPERATURE=0.0
CHROMA_DIR=./chroma_healthcare
DATA_DIR=./data
